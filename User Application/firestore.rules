rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      // User can read and write only their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reported civic issues
    match /issues/{issueId} {
      // Any authenticated citizen can view civic issues
      allow read: if request.auth != null;
      
      // An authenticated user can create an issue if the reporter UID matches their UID
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      
      // Only the reporter can update or delete their issue
      allow update, delete: if request.auth != null && resource.data.reporterUid == request.auth.uid;
    }
  }
}
